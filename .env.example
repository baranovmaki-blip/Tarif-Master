# Скопируйте этот файл в .env и впишите свои реальные значения.
# .env в git не попадает (см. .gitignore) — секреты остаются только у вас.

BOT_TOKEN=YOUR_BOT_TOKEN
CLAUDE_API_KEY=YOUR_CLAUDE_API_KEY

# Токен отдельного бота link_bot.py (кнопка "Получить ссылку") — свой
# отдельный токен из @BotFather, не тот же самый, что BOT_TOKEN.
LINK_BOT_TOKEN=YOUR_LINK_BOT_TOKEN

ADMIN_CHAT_ID=YOUR_ADMIN_CHAT_ID
MANAGER_CHAT_ID=YOUR_MANAGER_CHAT_ID

YOOKASSA_SHOP_ID=YOUR_SHOP_ID
YOOKASSA_SECRET_KEY=YOUR_SECRET_KEY

MANAGER_TELEGRAM_USERNAME=MinBar_Co

# Публичный https-адрес, где размещён webapp.html (см. README) — например,
# https://username.github.io/repo/webapp.html при хостинге на GitHub Pages.
WEBAPP_URL=

GOOGLE_SHEETS_URL=

EMAIL_ACCOUNT=YOUR_EMAIL@gmail.com
EMAIL_APP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
